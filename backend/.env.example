# Copy to .env and fill in. Never commit .env.

# ─── Database ────────────────────────────────────────────────────────────────
# connection_limit: connections Prisma may open (10 is plenty for one restaurant).
DATABASE_URL="postgresql://deniz:YOUR_PASSWORD@localhost:5432/deniz?schema=public&connection_limit=10"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# In production: 127.0.0.1, so the API is reachable only through nginx (the default in production).
# HOST=127.0.0.1
NODE_ENV=development
# Public address of this API (only used in the startup log).
APP_URL="http://localhost:3000"
# Number of reverse proxies in front of the server: nginx = 1 (the default in production); a CDN in front of
# nginx = 2. Wrong values make the rate limits see one IP for everyone (too low) or let clients fake their IP (too high).
# TRUST_PROXY=1

# Long random string (32+ characters), e.g. the output of: openssl rand -hex 32
# Required in production; the server refuses to start with this example value.
ADMIN_JWT_SECRET="change-me-admin-secret-at-least-32-characters"

# ─── Frontend address ────────────────────────────────────────────────────────
# Leave empty when the frontend and this API are on the same address (e.g. deniz.ir and deniz.ir/api via nginx).
# Otherwise list the frontend address(es), comma separated, protocol + domain only:
# CORS_ORIGINS="https://deniz.ir,https://admin.deniz.ir"
CORS_ORIGINS=""
# Only when the admin panel is on a different *site* than the API (e.g. panel on vercel.app, API on deniz.ir).
# Not needed for subdomains of one site (deniz.ir + api.deniz.ir). Requires https.
# ADMIN_COOKIE_CROSS_SITE=true

# ─── First admin account (created by `npm run db:seed`) ──────────────────────
# This account gets the DEVELOPER role. 8+ characters, at most 72 bytes. Remove the password from .env after seeding.
SEED_ADMIN_USERNAME="developer"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
SEED_ADMIN_NAME="Developer"

# ─── Tests only ──────────────────────────────────────────────────────────────
# A SEPARATE database whose name contains "test". It is wiped on every `npm test`.
# TEST_DATABASE_URL="postgresql://deniz:YOUR_PASSWORD@localhost:5432/deniz_test?schema=public"
